{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdreader",
  "version": "0.1.0",
  "identifier": "com.mdreader.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mdreader",
        "width": 980,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown",
        "exportedType": {
          "identifier": "com.mdreader.markdown",
          "conformsTo": ["public.plain-text"]
        }
      }
    ]
  }
}
